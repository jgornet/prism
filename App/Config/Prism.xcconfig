// Prism build settings. Committed.
//
// Defaults first; Signing.xcconfig (git ignored, copy Signing.example.xcconfig)
// overrides them for your own team and bundle id. Cloud.xcconfig points the app
// at Soma cloud; replace its two values to use your own Supabase project.
// HealthServer.xcconfig names the health server of this build, or none.
PRISM_BUNDLE_ID = Soma.Prism
PRISM_DEVELOPMENT_TEAM =
#include "Cloud.xcconfig"
#include "HealthServer.xcconfig"
#include? "Signing.xcconfig"
#include? "Supabase.xcconfig"
